# --- Supabase (Project Settings → API Keys) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose this to the browser or commit it.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Site ---
# Canonical URL for share links, OG images and the OAuth redirect. Optional on Vercel
# (defaults to the production domain); set it once you add a custom domain.
SITE_URL=https://wishcode.example

# --- Optional ---
# Name of the deployed embeddings Edge Function (supabase/functions/embed,
# Supabase's built-in gte-small model, no model fee). Set to "embed" once it's
# deployed. Unset: duplicate suggestions use Postgres trigram matching only.
EMBEDDINGS_FUNCTION=

# Pepper for hashing client IPs in rate-limit keys (defaults to the secret key).
RATE_LIMIT_SALT=

# Comma-separated GitHub handles granted admin on sign-in (admin UI is not built yet).
ADMIN_GITHUB_HANDLES=

# PostHog product analytics (optional).
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
