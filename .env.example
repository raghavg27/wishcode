# --- Supabase (Project Settings → API Keys) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose this to the browser or commit it.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Site ---
# Canonical URL for share links, OG images and the OAuth redirect. Optional on Vercel
# (defaults to the production domain); set it once you add a custom domain.
SITE_URL=https://wishcode.example

# --- Optional ---
# Embeddings for duplicate suggestions (OpenAI-compatible, 1536 dims).
# Without a key, duplicate suggestions fall back to Postgres trigram matching.
EMBEDDINGS_API_KEY=
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small

# Pepper for hashing client IPs in rate-limit keys (defaults to the secret key).
RATE_LIMIT_SALT=

# Comma-separated GitHub handles granted admin on sign-in (admin UI is not built yet).
ADMIN_GITHUB_HANDLES=

# PostHog product analytics (optional).
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
