# --- Supabase (Project Settings → API Keys) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose this to the browser or commit it.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Site ---
# Canonical URL for share links, OG images and the OAuth redirect. Optional on Vercel
# (defaults to the production domain); set it once you add a custom domain.
SITE_URL=https://wishcode.example

# --- Optional ---
# Name of the deployed embeddings Edge Function (supabase/functions/embed,
# Supabase's built-in gte-small model, no model fee). Set to "embed" once it's
# deployed. Unset: duplicate suggestions use Postgres trigram matching only.
EMBEDDINGS_FUNCTION=

# Gmail account that sends "someone built your wish" emails, and a Google App
# Password for it (needs 2-Step Verification; see README). Unset: no emails.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Signs the vote and unsubscribe links in emails (defaults to the secret key).
EMAIL_TOKEN_SECRET=

# Pepper for hashing client IPs in rate-limit keys (defaults to the secret key).
RATE_LIMIT_SALT=

# Comma-separated numeric GitHub user ids granted admin on sign-in (the /admin
# report queue). Find yours at https://api.github.com/users/<handle> ("id").
ADMIN_GITHUB_IDS=

# Cloudflare Turnstile bot check on posting a wish (see README). Set both or
# neither; unset, posting has no bot check. The site key is public.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PostHog analytics (optional). Turn on cookieless server hash mode in the
# PostHog project settings, or PostHog drops every event. For an EU project,
# set the host to https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error tracking (optional). The DSN is public. The other three let
# production builds upload source maps so stack traces show the real code.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
